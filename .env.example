# Copy to .env and fill in real values. Loaded via pydantic-settings
# (app/config.py, SettingsConfigDict(env_file=".env")) — every var below
# maps 1:1 to a Settings field there; unknown/extra vars are silently
# ignored, so a typo'd name here just won't take effect (no startup error).

# ---- Registry database (tenant_registry_db) ----
# Connection to the shared registry DB that tracks which businesses exist
# and which per-tenant database each one's data lives in — NOT any
# tenant's own data (see app/tenant_db.py for that, provisioned per-tenant
# at registration time, not listed here).
DATABASE_URL=postgresql+asyncpg://salon_user:salon_pass@localhost:5432/tenant_registry_db

# Seconds of client silence before the debounced reply pipeline fires
# (app/services/message_intake.py) — rarely needs changing.
DEBOUNCE_DELAY_SECONDS=3.0

# ---- AI provider (MainAIService + GuardrailService) ----
# "openai" or "gemini" — both go through the same OpenAI-compatible client
# (app/services/ai_client.py). IMPORTANT: Gemini's endpoint returns 400
# "User location is not supported" from Russian IPs, and OpenAI has blocked
# Russia since 2022 — this app must run on a VPS outside Russia for either
# provider to work at all; a proxy is not configured here (ai_client.py
# uses a plain AsyncOpenAI() with no http_client override).
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Cheap/fast classifier model for GuardrailService — deliberately separate
# from AI_MODEL so it can stay smaller than the main reply generator.
GUARDRAIL_MODEL=gpt-4o-mini

# Used for AI_PROVIDER=gemini above, AND (independently) by GeminiService's
# own Kyrgyz-language reply path, which always talks to Gemini directly via
# the native google-genai SDK regardless of AI_PROVIDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Telegram ----
# Only used by scripts/tooling for convenience (e.g. printing the setWebhook
# command) — actual per-tenant webhook routing is DB-driven via
# Tenant.telegram_bot_token, linked through PUT /api/v1/auth/telegram-bot-token.
TELEGRAM_BOT_TOKEN=

# Where pilot-dialog-limit warnings (app/services/pilot_limit_service.py) get
# sent for dalfy's own team, via TELEGRAM_BOT_TOKEN above. Leave empty to
# fall back to the always-on log line only.
DALFY_ADMIN_TELEGRAM_CHAT_ID=

# ---- Auth ----
# MUST be a real random secret in production — the default in config.py is
# explicitly insecure and only meant for local dev.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list (NOT a JSON array — app/config.py parses this with a
# plain .split(",")), no spaces needed around commas, no brackets/quotes.
# Must be the real admin-panel origin(s) — CORSMiddleware rejects
# credentialed requests from anything not listed here (wildcard "*" isn't
# usable with allow_credentials=True).
CORS_ORIGINS=https://admin.dalfy.net,http://localhost:3000

# NOTE: there is no BASE_URL setting here — that's a salon-admin (frontend)
# concept, not a backend one. The frontend is a static vanilla-JS site with
# no env-var/build mechanism; its API target is the BASE_URL constant
# hardcoded in salon-admin/js/config.js and must be updated there directly
# before deploy (see that repo).
